ull,\"matchingSnippet\":null,\"matchingSnippets\":null,\"type\":\"CHAT\",\"__typename\":\"Conversation\"},\"cursor\":\"MTA=\"},{\"node\":{\"id\":\"e40726e8-f1a1-47a7-b35a-11fb8f9e04aa\",\"updatedAt\":\"2026-09-21T12:28:08.000Z\",\"lastSendMessageTimestampMs\":1789993688586,\"conversationId\":\"e40726e8-f1a1-47a7-b35a-11fb8f9e04aa\",\"isPersisted\":true,\"title\":\"Solución de crucigrama bíblico\",\"displayTitle\":\"Solución de crucigrama bíblico\",\"pinned\":false,\"isUnread\":false,\"wearableSurface\":null,\"matchingSnippet\":null,\"matchingSnippets\":null,\"type\":\"CHAT\",\"__typename\":\"Conversation\"},\"cursor\":\"MTE=\"}],\"pageInfo\":{\"endCursor\":\"MTE=\",\"hasNextPage\":false}}}}\n"])</script><script nonce="">$RS("S:21","P:21")</script><script nonce="">$RC("B:1c","S:1c")</script><script nonce="">$RC("B:1e","S:1e")</script><script nonce="">self.__next_f.push([1,"89:{\"data\":{\"conversationStartersByType\":[{\"id\":\"915196468279811\",\"text\":\"Crea un GIF de esta persona en 16 estilos\",\"longPrompt\":\"Crea un GIF de una persona en primer plano con diferentes estilos\",\"type\":\"imagine_media_picker\",\"attachment_type\":\"MEDIA_PICKER\",\"category\":null,\"responseDisplayMode\":null},{\"id\":\"1934431373911260\",\"text\":\"Imagina a esta persona con varios peinados populares\",\"longPrompt\":\"Crea una fila de tres imágenes en las que aparezca la persona con nuevos peinados de moda inspirados en las tendencias de Instagram. Los peinados deben elegirse de forma que se adapten a la personalidad de la persona y resalten sus rasgos. Cada imagen debe ser un retrato en el que la persona pose de manera que se aprecie bien su cabello, sobre un fondo liso de color claro y con iluminación profesional de tipo comercial.\",\"type\":\"imagine_media_picker\",\"attachment_type\":\"MEDIA_PICKER\",\"category\":null,\"responseDisplayMode\":null},{\"id\":\"1355436600030889\",\"text\":\"Convierte esta habitación en un sala acuario\",\"longPrompt\":\"Convierte la imagen de una habitación en una pecera. Reduce el tamaño de los objetos y colócalos en un tanque con peces nadando alrededor para crear una habitación acuática. No incluyas las paredes ni el techo de la habitación.\",\"type\":\"imagine_media_picker\",\"attachment_type\":\"MEDIA_PICKER\",\"category\":null,\"responseDisplayMode\":null},{\"id\":\"909839255192169\",\"text\":\"Destacar las insights de un informe\",\"longPrompt\":\"Tengo un informe con muchos datos y quiero entender lo que pone. Lo compartiré contigo para que me ayudes a extraer las conclusiones más importantes.\",\"type\":\"learn\",\"attachment_type\":\"MEDIA_PICKER\",\"category\":\"IDEAS\",\"responseDisplayMode\":\"full_prompt\"}]}}\n"])</script><script nonce="">$RC("B:f","S:f")</script><next-route-announcer style="position: absolute;"><template shadowrootmode="open"><div aria-live="assertive" id="__next-route-announcer__" role="alert" style="position: absolute; border: 0px; height: 1px; margin: -1px; padding: 0px; width: 1px; clip: rect(0px, 0px, 0px, 0px); overflow: hidden; white-space: nowrap; overflow-wrap: normal;"></div></template></next-route-announcer></body></html>