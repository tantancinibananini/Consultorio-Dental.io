"">self.__next_f.push([1,"9a:I[332099,[\"/_next/static/immutable/chunks/00d_vqwdd7f69.js\",\"/_next/static/immutable/chunks/1pv9kgbqg0tyk.js\",\"/_next/static/immutable/chunks/186dw0ogvrg1a.js\",\"/_next/static/immutable/chunks/0fgf4ypmf4o1i.js\",\"/_next/static/immutable/chunks/3ouopy1x8r_ke.js\",\"/_next/static/immutable/chunks/3kh1-y68up_1c.js\",\"/_next/static/immutable/chunks/0pa3muu6t54-j.js\",\"/_next/static/immutable/chunks/1wp4az1jj6z8d.js\",\"/_next/static/immutable/chunks/2djos1cqpaop3.js\",\"/_next/static/immutable/chunks/2s9_m5pdqgkw-.js\",\"/_next/static/immutable/chunks/43hpvjyubs-4l.js\",\"/_next/static/immutable/chunks/41bwrdh2osurt.js\",\"/_next/static/immutable/chunks/082_0eg3eggt8.js\",\"/_next/static/immutable/chunks/3pygpcn8hoy_z.js\",\"/_next/static/immutable/chunks/3sllsib7seige.js\",\"/_next/static/immutable/chunks/44_94wpxpis4v.js\",\"/_next/static/immutable/chunks/3v5ncwfhgrdqd.js\",\"/_next/static/immutable/chunks/0lszvz5gknx01.js\",\"/_next/static/immutable/chunks/1dkrcdpwdodfc.js\",\"/_next/static/immutable/chunks/2iv9d80g7yztl.js\",\"/_next/static/immutable/chunks/16p5thu0avn4l.js\",\"/_next/static/immutable/chunks/0-1wk23_1hm9l.js\",\"/_next/static/immutable/chunks/1dzpxwet_qhq2.js\",\"/_next/static/immutable/chunks/0abkm65pj6ivz.js\",\"/_next/static/immutable/chunks/0lpt5p3iuzhy7.js\",\"/_next/static/immutable/chunks/2uiwwagg7vjxk.js\",\"/_next/static/immutable/chunks/067hzxtik6plz.js\",\"/_next/static/immutable/chunks/082lf7dpbjnt3.js\",\"/_next/static/immutable/chunks/2an1zazfutdvz.js\",\"/_next/static/immutable/chunks/21xl7171h-_0s.js\",\"/_next/static/immutable/chunks/2h_vrmt6ioc1e.js\",\"/_next/static/immutable/chunks/1ool8m0f0yvd_.js\",\"/_next/static/immutable/chunks/3l4japnlysvkj.js\",\"/_next/static/immutable/chunks/16cas_bg4suwj.js\",\"/_next/static/immutable/chunks/2sfe9ujz3mk24.js\",\"/_next/static/immutable/chunks/01tp54g_9rzs5.js\",\"/_next/static/immutable/chunks/1dv4okk_otgcy.js\",\"/_next/static/immutable/chunks/09pp3hvtyp33_.js\",\"/_next/static/immutable/chunks/1d5zoznm_u5_3.js\",\"/_next/static/immutable/chunks/0tw9pelptqtwd.js\",\"/_next/static/immutable/chunks/3fn3pjofcejrg.js\",\"/_next/static/immutable/chunks/3dge6-rr4389i.js\",\"/_next/static/immutable/chunks/100ybnung-a3s.js\"],\"EctoCreditComposerBanners\"]\n4a:[\"$\",\"$L4f\",null,{\"preloads\":{},\"serverParamsMap\":{},\"params\":{},\"searchParams\":{},\"requestParams\":{\"rankingSessionId\":\"586bd39c-707e-4c0c-83d5-37eb651c2a72\"},\"children\":[\"$\",\"$L9a\",null,{\"preloadedBenefit\":null}]}]\n"])</script><script nonce="">$RC("B:8","S:8")</script><script nonce="">self.__next_f.push([1,"8e:{\"data\":{\"conversationStartersByType\":[{\"id\":\"909839255192169\",\"text\":\"Destacar las insights de un informe\",\"longPrompt\":\"Tengo un informe con muchos datos y quiero entender lo que pone. Lo compartiré contigo para que me ayudes a extraer las conclusiones más importantes.\",\"type\":\"learn\",\"attachment_type\":\"MEDIA_PICKER\",\"category\":\"IDEAS\",\"responseDisplayMode\":\"full_prompt\"},{\"id\":\"1658695762220852\",\"text\":\"Crear elementos de acción a partir de notas\",\"longPrompt\":\"Crear elementos de acción a partir de notas\",\"type\":\"learn\",\"attachment_type\":\"NONE\",\"category\":\"INFO_GATHERING\",\"responseDisplayMode\":\"default\"},{\"id\":\"1433117561847204\",\"text\":\"Depurar mi código\",\"longPrompt\":\"Mi código no funciona y no sé por qué. Lo compartiré contigo para que me ayudes a encontrar el error y me expliques en qué me he equivocado.\",\"type\":\"learn\",\"attachment_type\":\"NONE\",\"category\":\"TEST\",\"responseDisplayMode\":\"full_prompt\"},{\"id\":\"1479036213963588\",\"text\":\"Envía comentarios sobre un diseño\",\"longPrompt\":\"Envía comentarios sobre un diseño\",\"type\":\"learn\",\"attachment_type\":\"MEDIA_PICKER\",\"category\":\"INFO_GATHERING\",\"responseDisplayMode\":\"default\"}]}}\n"])</script><script nonce="">$RC("B:14","S:14")</script><script nonce="">self.__next_f.push([1,"8d:{\"data\":{\"conversationStartersByType\":[{\"id\":\"1243809197876134\",\"text\":\"Revisar mi ensayo\",\"longPrompt\":\"Acabo de terminar el borrador de un ensayo y me gustaría recibir comentarios sinceros al respecto.\",\"type\":\"learn\",\"attachment_type\":\"NONE\",\"category\":\"WRITE\",\"responseDisplayMode\":\"full_prompt\"},{\"id\":\"1090726650783958\",\"text\":\"Resolver un problema de matemáticas complejo\",\"longPrompt\":\"Estoy atascado con un problema de matemáticas y necesito ayuda para resolverlo. Oriéntame hasta llegar a la solución paso a paso para que realmente lo entienda.\",\"type\":\"learn\",\"attachment_type\":\"NONE\",\"category\":\"LEARN\",\"responseDisplayMode\":\"full_prompt\"},{\"id\":\"1348266374002738\",\"text\":\"Evaluar mi currículum\",\"longPrompt\":\"¿Puedes echar un vistazo a mi currículum y decirme qué está funcionando y qué no?\",\"type\":\"learn\",\"attachment_type\":\"NONE\",\"category\":\"WRITE\",\"responseDisplayMode\":\"full_prompt\"},{\"id\":\"910702038433183\",\"text\":\"Simular una entrevista\",\"longPrompt\":\"Tengo una entrevista próximamente y quiero practicar. Actúa como si fueras un responsable de contratación real y hazme algunas preguntas difíciles.\",\"type\":\"learn\",\"attachment_type\":\"NONE\",\"category\":\"SUGGEST\",\"responseDisplayMode\":\"full_prompt\"}]}}\n"])</script><script nonce="">$RC("B:13","S:13")</script><script nonce="">self.__next_f.push([1,"8a:{\"data\":{\"conversationStartersByType\":[{\"id\":\"1995013938110921\",\"text\":\"Transcribe notas escritas a mano\",\"longPrompt\":\"Transcribe notas escritas a mano\",\"type\":\"learn\",\"attachment_type\":\"CAMERA_MEDIA\",\"category\":\"INFO_GATHERING\",\"responseDisplayMode\":\"default\"},{\"id\":\"1348266374002738\",\"text\":\"Evaluar mi currículum\",\"longPrompt\":\"¿Puedes echar un vistazo a mi currículum y decirme qué está funcionando y qué no?\",\"type\":\"learn\",\"attachment_type\":\"NONE\",\"category\":\"WRITE\",\"responseDisplayMode\":\"full_prompt\"},{\"id\":\"1260708592793455\",\"text\":\"Describe lo que está pasando en una imagen\",\"longPrompt\":\"Voy a compartir una imagen. Dime lo que ves y qué está pasando en ella.\",\"type\":\"learn\",\"attachment_type\":\"CAMERA_MEDIA\",\"category\":\"MULTIMODAL\",\"responseDisplayMode\":\"full_prompt\"},{\"id\":\"1602379481031442\",\"text\":\"Ayuda para crear un sitio web\",\"longPrompt\":\"Quiero crear un sitio web, pero no sé por dónde empezar. Ayúdame a encontrar la mejor forma de hacerlo.\",\"type\":\"learn\",\"attachment_type\":\"NONE\",\"category\":\"PLAN\",\"responseDisplayMode\":\"full_prompt\"}]}}\n"])</script><script nonce="">$RC("B:10","S:10")</script><script nonce="">self.__next_f.push([1,"8c:{\"data\":{\"conversationStartersByType\":[]}}\n"])</script><script nonce="">$RC("B:12","S:12")</script><script nonce="">self.__next_f.push([1,"94:[]\n"])</script><script nonce="">$RS("S:e","P:e")</script><script nonce="">$RC("B:9","S:9")</script><script nonce="">self.__next_f.push([1,"96:{\"data\":{\"viewer\":{\"__typename\":\"Ecto1ViewerContext\",\"__isIViewerContext\":\"Ecto1ViewerContext\",\"tosRegion\":\"ROW\",\"socialProfile\":{\"username\":\"jhona.siles.2025\",\"profile_picture\":\"https://scontent-iad6-1.xx.fbcdn.net/v/t39.30808-6/486849534_122167589318293705_4864545139891225262_n.jpg?_nc_cat=106\u0026ccb=1-7\u0026_nc_sid=b94e50\u0026_nc_ohc=78dNsRh-jp8Q7kNvwFXJQIo\u0026_nc_oc=AdqrwlYwvcIQKzElmTHSM77bPJBxyi7FlOzwGkN5t8pNyRrYAVg5GnFF5ZJPLuQrH8M\u0026_nc_zt=23\u0026_nc_ht=scontent-iad6-1.xx\u0026_nc_gid=HG3UtY9Vapq0kYpSjkDyDQ\u0026_nc_ss=7b2a8\u0026oh=00_AQP22OosdhL3lIbo6PHnzgziEwT6N5GxfOc5TQXxH39omQ\u0026oe=6AD1F729\"},\"id\":\"viewer:0f42f71b-039d-485a-b6ea-58a71b973846\"}}}\n"])</script><link rel="preload" as="image" href="./consultorio_files/486849534_122167589318293705_4864545139891225262_n.jpg"><script nonce="">$RC("B:1f","S:1f")</script><script nonce="">$RC("B:1d","S:1d")</script><script nonce="">self.__next_f.push([1,"64:true\n79:true\n"])</script><script nonce="">$RC("B:1","S:1")</script><script nonce="">self.__next_f.push([1,"97:{\"data\":{\"notifications_count\":0}}\n"])</script><script nonce="">$RC("B:20","S:20")</script><script nonce="">$RC("B:22","S:22")</script><script nonce="">self.__next_f.push([1,"91:[{\"id\":\"1595749168589438\",\"text\":\"Audita mis suscripciones de pago\",\"prompt\":\"Recopila todas mis suscripciones activas y dime cuáles son realmente útiles y cuáles no\",\"iconName\":\"LIST_BADGE_SEARCH\",\"thumbnailUrl\":null,\"attachmentType\":\"NONE\",\"mode\":\"think_hard\"},{\"id\":\"37298981036384422\",\"text\":\"Crea una receta de temporada que sea tendencia\",\"prompt\":\"Identifica una receta popular que utilice ingredientes de temporada y locales. Preséntala en un artefacto atractivo e interactivo, con sustituciones y contenido multimedia.\",\"iconName\":\"WHISK_SPATULA\",\"thumbnailUrl\":\"https://scontent-iad6-1.xx.fbcdn.net/m1/v/t0.83350-7/AQOG8SnUkC3xYne192WUb5dfbJooTAjxu-g4NxY7D9OcX6QuiUXMTqDE9bjuhecby37bYdZDvDSDXRPY15LKldV7zNF44xQULTlFTFpg5P_fa_vbmRG2ShhUK9WJFIQbTfUGp6uBKt38z3iO.jpg?stp=s256x256\u0026_nc_gid=acu_Wrh83aCrq6mt5qmBRQ\u0026_nc_oc=AdouBGUxXRdyjIadvS3URwCtXUw2UXMYCtJPD2KkmuP_AeBEOniC73Jhgm5xFysaYSU\u0026strext=1\u0026ccb=10-5\u0026oh=00_AQOXOb2H36AFCs_8pyEAFZRWEewFTD3oFas1cHoa9ZK1wg\u0026oe=6ACE1426\u0026_nc_sid=087463\",\"attachmentType\":\"NONE\",\"mode\":\"think_hard\"},{\"id\":\"27859575287011134\",\"text\":\"Crea un plan de entrenamiento para principiantes\",\"prompt\":\"Quiero empezar a correr, pero no tengo experiencia. Usa subagentes para diseñar un plan de 0 a 5 km y consejos para no abandonar después de la primera semana.\",\"iconName\":\"FIGURE_RUNNING\",\"thumbnailUrl\":\"https://scontent-iad6-1.xx.fbcdn.net/m1/v/t0.83350-7/AQPCGxUhDzGiKUgOcs9AR6yEKqBZVc-mw8aM143Q3PKMzH9-T9Ora-_fS_ZQCYiMGU10jyu8PucSk5dLeI8Ci4_GvMwDNhZ85xuGj6PkyjOUqvuGSX48_75srhmbzcJr5380dFzblKFXEzVt8w.jpg?stp=s256x256\u0026_nc_gid=acu_Wrh83aCrq6mt5qmBRQ\u0026_nc_oc=AdrJ-jBEufGd9MCt09X1YnUUexnDcICe5jUVbToqXaKikBiEsKWagO7m6pUOM44FjaY\u0026strext=1\u0026ccb=10-5\u0026oh=00_AQOSAGEA769ipI-p5PJwEvkEGTPtpCebfQOUMaRX41bjlQ\u0026oe=6ACE1840\u0026_nc_sid=087463\",\"attachmentType\":\"NONE\",\"mode\":\"think_fast\"},{\"id\":\"1057641619954637\",\"text\":\"Explica la biología de las criaturas míticas\",\"prompt\":\"Háblame sobre los dragones, las fénix, los kraken, los unicornios y las sirenas. Inicia subagentes para explicar cómo funcionaría biológicamente la habilidad característica de cada criatura (respirar fuego, regeneración, supervivencia a la presión de las profundidades marinas, etc.). Organiza la respuesta por criatura e incluye una imagen o infografía de cada una.\",\"iconName\":\"BOOK\",\"thumbnailUrl\":null,\"attachmentType\":\"NONE\",\"mode\":\"think_hard\"},{\"id\":\"1740428430323169\",\"text\":\"Crea un entrenamiento diario de 20 minutos\",\"prompt\":\"Configura una tarea diaria para las 6:00. Cada mañana, dame un entrenamiento de 20 minutos en casa sin equipamiento. Cambia los grupos musculares cada día para que varíe y se vayan desarrollando a lo largo de la semana. Dime en qué se centra el entrenamiento del día y la intensidad a la que debe llegar. Para cada ejercicio, incluye una imagen clara, instrucciones sencillas con una forma de hacer el ejercicio o una señal de seguridad, y el número de repeticiones o el intervalo entre entreno y descanso. Añade un calentamiento y una relajación breves, y proporciona una opción más fácil y otra más difícil. El entrenamiento no debe superar los 20 minutos. Ponlo en marcha ahora además de crear la tarea.\",\"iconName\":\"FIGURE_BARBELL\",\"thumbnailUrl\":\"https://scontent-iad6-1.xx.fbcdn.net/m1/v/t0.83350-7/AQNJxML8bAENyzHTGplJA35rjPnnva5093i3PZyZ0FrvADaGUalQWeqeEBXnIlwTXAkX9tHcXIF1j5j5R63scDP-mQGYuCowngZDisdShs5P1FFVN0BNCkcInr__Rfm4pTizIgvB9elTLNlQ.jpg?stp=s256x256\u0026_nc_gid=acu_Wrh83aCrq6mt5qmBRQ\u0026_nc_oc=AdplIK8uTZRF77cQogc-oLNJCzJ2DVlRstLH1IzW9GgDOaX14fGDnqAD2C_6bXkfP48\u0026strext=1\u0026ccb=10-5\u0026oh=00_AQMQjB7u28YX3tidXrdnDRPxNklj4y7rSNGPZpwpX8qQzQ\u0026oe=6ACE16D7\u0026_nc_sid=087463\",\"attachmentType\":\"NONE\",\"mode\":\"think_fast\"},{\"id\":\"25952502591114573\",\"text\":\"Planifica una cena coreana de barbacoa\",\"prompt\":\"Crea un artefacto rico y atractivo para enseñarme a preparar una cena tradicional de barbacoa coreana en casa\",\"iconName\":\"FORK_KNIFE\",\"thumbnailUrl\":\"https://scontent-iad6-1.xx.fbcdn.net/m1/v/t0.83350-7/AQNyCi5VkutLruhx24oTpfEY9U3tzZycRpaSP8gOhvAPGlYgwthXDy__L287hWpujXRrcRRV_EEFUL3_oFde2Vjr0cTvij1kpPuFE_F5PVe3UFCD_BtgZgzJrteuLbgfVOCyEKfxDHGXFECYlA.jpg?stp=s256x256\u0026_nc_gid=acu_Wrh83aCrq6mt5qmBRQ\u0026_nc_oc=AdrUkuDLlwkdSH_Diqg9elcv1W5Ru1mpsOKW_s92gr1te4ZFi-TVJFPQFsO8ZyMwc8c\u0026strext=1\u0026ccb=10-5\u0026oh=00_AQNHJxb9ultfnngvooL6Vk6LYB38IoO9ygMnfD8SxoraMA\u0026oe=6ACDEFE4\u0026_nc_sid=087463\",\"attachmentType\":\"NONE\",\"mode\":\"think_hard\"},{\"id\":\"2929033954104297\",\"text\":\"Planifica un sábado perfecto\",\"prompt\":\"Tengo un sábado libre dentro de poco. Activa tres subagentes y dame tres opciones: una actividad al aire libre, una cultural y una tranquila, todas cerca de mí. Consulta cuáles son las tendencias y los acontecimientos en mi zona este fin de semana. Incluye contenido en el texto para mostrarme cuáles son mis opciones.\",\"iconName\":\"SUN_HAZE\",\"thumbnailUrl\":\"https://scontent-iad6-1.xx.fbcdn.net/m1/v/t0.83350-7/AQOeBE0UKt0Tv2IlwrGWhYeHMXuW631PwnYrJbx47CkGrtosYL156fmNMuFhtXYkLpGZ88kxPm-n8Qc9WNZcBaR5iRmjHnbewvXzXBTd8wrEzt1XCBr1oALuYeANz9OLc0P0wNW3lmDDIGzGsA.jpg?stp=s256x256\u0026_nc_gid=acu_Wrh83aCrq6mt5qmBRQ\u0026_nc_oc=AdoPtay9iMI_vIC1vfDXl4MNjQ6HgM-PiUzyJX4zBsvJHoZBaTpxgwvbOB9vReCHMJE\u0026strext=1\u0026ccb=10-5\u0026oh=00_AQMDs_QaNJ1A2JVYQcOHlc1-zoVqRWEhqM0-1AB7wyOQ9Q\u0026oe=6ACE0CEB\u0026_nc_sid=087463\",\"attachmentType\":\"NONE\",\"mode\":\"think_fast\"},{\"id\":\"1544611136608330\",\"text\":\"Resume el calendario y el correo electrónico\",\"prompt\":\"Lee la bandeja de entrada de mi correo electrónico y mi calendario, y resume los elementos de acción para la semana que viene de forma atractiva. Usa secciones agrupadas y una viñeta clara por elemento de acción. Céntrate en la bandeja de entrada del correo electrónico en concreto. No hagas una lista de todos los eventos del calendario, solo destaca las acciones que debo realizar. Usa la fecha y la hora actuales y no hagas referencia a eventos pasados. Crea este resumen rápidamente. Si aún no he conectado mi correo electrónico o mi calendario, ayúdame a hacerlo primero. Después de ejecutarlo, pregúntame si quiero convertirlo en una tarea diaria programada.\",\"iconName\":\"ENVELOPE\",\"thumbnailUrl\":\"https://scontent-iad6-1.xx.fbcdn.net/m1/v/t0.83350-7/AQM791MYLjp0FsDYQzOL4vjKQF9_VBQrLtMUMslBKWXrGLGuJlrSCyY-KCB85lzDgGYMI6oVybQprtEjpifbpoQm_4ypbKG2gAxb1iWy2dephnT0EQ5IH-wNr3iloX_21K_DSmcdDaEyvESznw.jpg?stp=s256x256\u0026_nc_gid=acu_Wrh83aCrq6mt5qmBRQ\u0026_nc_oc=AdqB4SqUgJ37g83Jp2zJOjd96gaGC9TwDPXwvO183XWREISxiWJHAbrsmbOYGvm7_WM\u0026strext=1\u0026ccb=10-5\u0026oh=00_AQO38BLufgnkvhwc09jbsqAnsqwpcPADxVQ2zBXNGNGUcw\u0026oe=6ACDFB91\u0026_nc_sid=087463\",\"attachmentType\":\"NONE\",\"mode\":\"think_hard\"}]\n"])</script><script nonce="">self.__next_f.push([1,"51:{\"data\":{\"viewer\":{\"__typename\":\"Ecto1ViewerContext\",\"connectorStatuses\":[{\"integrationId\":\"488374083700647\",\"status\":\"DISCONNECTED\",\"slug\":\"google_calendar\",\"iconAsset\":\"connectorGoogleCal\",\"connectedAccount\":null},{\"integrationId\":\"926352316234214\",\"status\":\"DISCONNECTED\",\"slug\":\"gmail\",\"iconAsset\":\"connectorGoogleGmail\",\"connectedAccount\":null},{\"integrationId\":\"504910018845826\",\"status\":\"DISCONNECTED\",\"slug\":\"outlook_calendar\",\"iconAsset\":\"connectorMicrosoftCal\",\"connectedAccount\":null},{\"integrationId\":\"621332870257820\",\"status\":\"DISCONNECTED\",\"slug\":\"outlook_email\",\"iconAsset\":\"connectorMicrosoftOutlook\",\"connectedAccount\":null},{\"integrationId\":\"1299891395113112\",\"status\":\"DISCONNECTED\",\"slug\":\"gdrive\",\"iconAsset\":\"connectorGoogleDrive\",\"connectedAccount\":null},{\"integrationId\":\"1477498320524395\",\"status\":\"DISCONNECTED\",\"slug\":\"google_contacts\",\"iconAsset\":\"connectorGoogleContatcs\",\"connectedAccount\":null},{\"integrationId\":\"1409467414193595\",\"status\":\"DISCONNECTED\",\"slug\":\"outlook_contacts\",\"iconAsset\":\"connectorMicrosoftContacts\",\"connectedAccount\":null}],\"id\":\"viewer:0f42f71b-039d-485a-b6ea-58a71b973846\"}}}\n74:{\"data\":{\"viewer\":{\"__typename\":\"Ecto1ViewerContext\",\"connectorStatuses\":[{\"integrationId\":\"488374083700647\",\"status\":\"DISCONNECTED\",\"slug\":\"google_calendar\",\"iconAsset\":\"connectorGoogleCal\",\"connectedAccount\":null},{\"integrationId\":\"926352316234214\",\"status\":\"DISCONNECTED\",\"slug\":\"gmail\",\"iconAsset\":\"connectorGoogleGmail\",\"connectedAccount\":null},{\"integrationId\":\"504910018845826\",\"status\":\"DISCONNECTED\",\"slug\":\"outlook_calendar\",\"iconAsset\":\"connectorMicrosoftCal\",\"connectedAccount\":null},{\"integrationId\":\"621332870257820\",\"status\":\"DISCONNECTED\",\"slug\":\"outlook_email\",\"iconAsset\":\"connectorMicrosoftOutlook\",\"connectedAccount\":null},{\"integrationId\":\"1299891395113112\",\"status\":\"DISCONNECTED\",\"slug\":\"gdrive\",\"iconAsset\":\"connectorGoogleDrive\",\"connectedAccount\":null},{\"integrationId\":\"1477498320524395\",\"status\":\"DISCONNECTED\",\"slug\":\"google_contacts\",\"iconAsset\":\"connectorGoogleContatcs\",\"connectedAccount\":null},{\"integrationId\":\"1409467414193595\",\"status\":\"DISCONNECTED\",\"slug\":\"outlook_contacts\",\"iconAsset\":\"connectorMicrosoftContacts\",\"connectedAccount\":null}],\"id\":\"viewer:0f42f71b-039d-485a-b6ea-58a71b973846\"}}}\n87:{\"data\":{\"viewer\":{\"__typename\":\"Ecto1ViewerContext\",\"connectors\":[{\"status\":\"DISCONNECTED\"},{\"status\":\"DISCONNECTED\"},{\"status\":\"DISCONNECTED\"},{\"status\":\"DISCONNECTED\"},{\"status\":\"DISCONNECTED\"},{\"status\":\"DISCONNECTED\"},{\"status\":\"DISCONNECTED\"}],\"id\":\"viewer:0f42f71b-039d-485a-b6ea-58a71b973846\"}}}\n"])</script><link rel="preload" as="image" href="https://static.xx.fbcdn.net/assets/?set=hatch_connector_logos&amp;name=connectorGoogleCal&amp;density=3x"><link rel="preload" as="image" href="https://static.xx.fbcdn.net/assets/?set=hatch_connector_logos&amp;name=connectorGoogleGmail&amp;density=3x"><script nonce="">$RC("B:4","S:4")</script><script nonce="">$RS("S:c","P:c")</script><script nonce="">$RC("B:a","S:a")</script><script nonce="">$RC("B:d","S:d")</script><script nonce="">self.__next_f.push([1,"9b:T8af,Busca en la web información sobre el tiempo y las tendencias de moda de mi ciudad. Si esta información no está disponible, usa la ciudad más poblada de mi país o región. Crea un conjunto para mí que se corresponda con el tiempo local, las tendencias de moda y mis preferencias personales. Recomiéndame artículos del conjunto para que los compre y muestra recomendaciones de compra después del texto. Usa mi imagen, manteniendo mi rostro, cabello y tono de piel, sin cambios y claramente reconocibles. Si mi imagen no está disponible, usa un maniquí neutro.\\nCrea una imagen mía de pie en un contrapposto relajado, con el peso apoyado en una pierna y la cadera opuesta más baja, con los hombros relajados (una postura que permita que la prenda caiga tal y como lo hace en la vida real). Fotografía de comercio electrónico de moda, luminosa y en un estilo minimalista japonés moderno; fondo de estudio continuo EXACTAMENTE en el tono blanco roto avena cálido #EAE4DA (no blanco, no gris y nunca en tonos fríos o azulados); el color del fondo es #EAE4DA de borde a borde, sin degradado ni dominantes de color; iluminación de luz diurna muy suave, prácticamente sin sombras y equilibrada, procedente de un gran softbox cenital, con un amplio relleno a ambos lados; colores limpios y neutros, contraste suave y sin sombras marcadas; pose relajada y natural, con una expresión neutra y desenfadada, accesible en lugar de distante; fotografía de cuerpo entero con los pies visibles, tomada con un objetivo de 85 mm a f/5,6 desde la altura de los ojos; el encuadre, la distancia al sujeto y la iluminación deben ser IDÉNTICOS en todas las imágenes de esta serie, y el backdrop es exactamente el mismo tono avena cálido #EAE4DA en todas ellas, sin cambios de matiz ni de brillo entre ellos, de modo que SOLO CAMBIE LA POSE. Fotografía de moda fotorrealista, tomada con una cámara de formato completo, textura natural de la piel y cabello natural, manos anatómicamente correctas, prendas bien ajustadas, con un peso y una caída del tejido creíbles. Sin texto, marcas de agua, logotipos superpuestos, collages ni imágenes divididas y con un único sujeto. Envía la imagen antes del texto del mensaje.9c:T8af,Busca en la web información sobre el tiempo y las tendencias de moda de mi ciudad. Si esta información no está disponible, usa la ciudad más poblada de mi país o región. Crea un conjunto para mí que se corresponda con el tiempo local, las tendencias de moda y mis preferencias personales. Recomiéndame artículos del conjunto para que los compre y muestra recomendaciones de compra después del texto. Usa mi imagen, manteniendo mi rostro, cabello y tono de piel, sin cambios y claramente reconocibles. Si mi imagen no está disponible, usa un maniquí neutro.\\nCrea una imagen mía de pie en un contrapposto relajado, con el peso apoyado en una pierna y la cadera opuesta más baja, con los hombros relajados (una postura que permita que la prenda caiga tal y como lo hace en la vida real). Fotografía de comercio electrónico de moda, luminosa y en un estilo minimalista japonés moderno; fondo de estudio continuo EXACTAMENTE en el tono blanco roto avena cálido #EAE4DA (no blanco, no gris y nunca en tonos fríos o azulados); el color del fondo es #EAE4DA de borde a borde, sin degradado ni dominantes de color; iluminación de luz diurna muy suave, prácticamente sin sombras y equilibrada, procedente de un gran softbox cenital, con un amplio relleno a ambos lados; colores limpios y neutros, contraste suave y sin sombras marcadas; pose relajada y natural, con una expresión neutra y desenfadada, accesible en lugar de distante; fotografía de cuerpo entero con los pies visibles, tomada con un objetivo de 85 mm a f/5,6 desde la altura de los ojos; el encuadre, la distancia al sujeto y la iluminación deben ser IDÉNTICOS en todas las imágenes de esta serie, y el backdrop es exactamente el mismo tono avena cálido #EAE4DA en todas ellas, sin cambios de matiz ni de brillo entre ellos, de modo que SOLO CAMBIE LA POSE. Fotografía de moda fotorrealista, tomada con una cámara de formato completo, textura natural de la piel y cabello natural, manos anatómicamente correctas, prendas bien ajustadas, con un peso y una caída del tejido creíbles. Sin texto, marcas de agua, logotipos superpuestos, collages ni imágenes divididas y con un único sujeto. Envía la imagen antes del texto del mensaje.9d:T2165,Crea cuatro pegatinas de luchador personalizadas utilizando las tres imágenes suministradas.\n\nEntradas\n\n  Entrada 1: Foto de identidad del usuario\n    Proporciona identidad, rostro, tono de piel, edad, cabello, vello facial, accesorios.\n\n  Entrada 2: Referencia exacta del atuendo\n    Proporciona camisa, pantalones cortos, guantes completos con logotipos, patrones, materiales, colores, colocación. Al crear la imagen de referencia, no le des zapatos al usuario. No deben dárseles zapatos.\n\n  Entrada 3: Hoja de tipografía\n    Imagen transparente con cuatro celdas: arriba a la izquierda GOAT, arriba a la derecha LFG, abajo a la izquierda AND NEW, abajo a la derecha UNDISPUTED. Este es arte real, no inspiración. Si se carga con fondo blanco, convierte el blanco a transparente y elimínalo, conservando la forma del texto. No rellenes áreas transparentes con color.\n\nRegla de fondo de segmentación (se aplica en todas partes)\n\n  Utiliza ÚNICAMENTE verde plano uniforme puro #00FF00 (RGB 0, 255, 0) para todos los fondos generados. Este verde es solo para segmentación y se eliminará para transparencia más tarde. No uses magenta #FF00FF, rosa, púrpura, ni ningún otro color de fondo. Sin gradiente, textura, sombras, ni viñeta en el fondo.\n\nRegla de fuente de arte de texto (se aplica a cada generación y edición)\n\n  La única fuente de letra permitida es la imagen de recorte de tipografía original preparada.\n  Cada generación de imagen o edición de imagen que muestre letra debe tener {{arte de palabra}} adjunto como entrada de imagen.\n  Un nombre de archivo, frase, descripción escrita, o pegatina generada previamente nunca es un sustituto.\n  No redibujes, reescribas, traces, sustituyas, aproximes, o reinterpretar la letra.\n  Mantén la letra delante del luchador, en su tamaño y posición originales.\n  Esto se aplica a la creación inicial, correcciones, reintentos, y todos los turnos de seguimiento.\n\nEtapa 1: Referencia canónica del luchador\n\n  Utiliza Entrada 1 + Entrada 2 para generar una referencia de cuerpo completo aislada de la persona que lleva el atuendo suministrado.\n\n  - Conserva la estructura facial reconocible, tono de piel, edad, cabello, vello facial, sombreros/gafas/cubiertas religiosas.\n  - Gafas, sombreros, cubiertas religiosas, dispositivos auditivos, y cualquier otro accesorio visible en la cara/cabeza en Entrada 1 son parte de la identidad de la persona. Consérvalos en la referencia canónica del luchador y en las cuatro pegatinas, con el mismo diseño, colores, y forma en que se llevan. No los elimines, reemplaces, o rediseñes para una pose o expresión.\n  - Anatomía fotográfica natural, sin músculos exagerados, sin cabeza/manos/pies agrandados.\n  - Transfiere la camisa, pantalones cortos, guantes exactos: cortes, longitudes, colores, materiales, patrones, logotipos, colocación. Se permiten pliegues naturales. No simplifiques ni inventes marcas.\n  - Pies descalzos a menos que haya calzado en Entrada 2.\n  - Fotorealista, con contraste ligeramente más fuerte, sombras direccionales malhumoradas. Grado editorial, no ilustración.\n  - Una persona, pose neutral de pie, todo el sombrero/cabello, ambas manos, ambas piernas, ambos pies visibles, márgenes cómodos.\n  - Genera en verde plano uniforme #00FF00, sin sombras ni gradiente. Sin borde. Sin magenta. Conserva como referencia canónica del luchador. No presentes al usuario.\n  - No le des zapatos al usuario.\n\n  Antes de continuar, confirma que la referencia conserva los accesorios de la cara/cabeza visibles en Entrada 1 y que el fondo es puro #00FF00.\n\nEtapa 2: Tipografía dividida\n\n  Lee las dimensiones de Entrada 3, recorta en los puntos medios horizontal y vertical en:\n    texto_cabra (arriba-izquierda), texto_lfg (arriba-derecha), texto_y_nuevo (abajo-izquierda), texto_indiscutible (abajo-derecha).\n\n  Conserva el lienzo completo, colocación, alfa. No recortes ajustados alrededor de la letra. Mantén las dimensiones originales de cada celda y conserva el tamaño y las coordenadas exactas del texto en relación con esa celda. Arriba sigue arriba, en medio sigue en medio, abajo sigue abajo; la colocación horizontal también permanece sin cambios. No muevas, redimensionar, recentrar, estirar, o refluir las palabras. No extiendas el lienzo de la celda. Utiliza estos recortes sin cambios como {{arte de palabra}} para la generación y cada edición posterior. No rellenes áreas transparentes con verde o magenta.\n\nEtapa 3: Cuatro ediciones de imagen en paralelo (borde en-generación)\n\n  Ejecuta una edición de imagen completa por celda en paralelo. Cada tarea obtiene: su recorte de tipografía preparado como base, la referencia canónica del luchador, y Entrada 2 como soporte. No pases solo descripciones de texto.\n\n  Utiliza el mismo mensaje de subagente a continuación para todas las cuatro tareas. Sustituye solo {{palabra}}, {{arte de palabra}}, {{pose}}, y {{archivo de salida}} utilizando las definiciones después de la plantilla. Reemplaza {{pose}} con la descripción completa de la pose, no un número de pose o resumen. Resuelve {{arte de palabra}} en la imagen real preparada y adjúntala; su nombre solo no es una entrada de imagen.\n\n  No parafrasees, acortes, embellezcas, o agregues diferentes instrucciones para diferentes agentes. Las únicas diferencias por agente son esas cuatro sustituciones y el recorte de tipografía correspondiente. Cada agente recibe la misma referencia canónica y la imagen del atuendo.\n\n  Incluye la misma descripción del borde y las instrucciones completas de eliminación de fondo en cada tarea del agente, incluyendo correcciones. Define una rutina de limpieza compartida determinista y haz que todos los agentes la reutilicen; no hagas que cada agente invente su algoritmo de segmentación de forma independiente. Mantén la generación de imágenes en paralelo. Si los agentes no pueden compartir la rutina, recopila sus renders intactos y ejecuta esa misma rutina de limpieza en los cuatro de forma centralizada.\n\n  Enrutamiento de seguimiento\n\n    La regla de reintentos y ediciones de seguimiento dentro de la plantilla del subagente es obligatoria para el padre y cada subagente en este turno y todos los turnos de seguimiento. Mantén cada pegatina asociada con su recorte de tipografía original preparado. Aplica la regla a cada corrección, incluyendo ediciones no relacionadas con la letra. Para trabajos de seguimiento, utiliza su plantilla de corrección en lugar de inventar un nuevo mensaje. Ejecuta correcciones independientes a pegatinas afectadas en paralelo donde sea compatible; deja las pegatinas no afectadas sin cambios.\n\nPlantilla de mensaje de subagente\n\n  Comienza el mensaje de subagente\n\n    Crea la pegatina {{palabra}} y devuelve {{archivo de salida}}.\n\n    Fondo de segmentación: Utiliza ÚNICAMENTE verde plano uniforme puro #00FF00. No uses magenta #FF00FF ni ningún otro color. Sin gradiente, textura, o sombras en el fondo.\n\n    Fuente de texto: {{arte de palabra}} es la única fuente de letra y debe adjuntarse. No reescribas las palabras.\n\n    Tienes tres imágenes adjuntas en este orden:\n      1. {{arte de palabra}}: el recorte de tipografía preparado. Esta es la imagen base para editar, no una referencia de estilo o inspiración.\n      2. Referencia canónica del luchador: la persona, proporciones, atuendo, y tratamiento fotográfico.\n      3. Entrada 2: la referencia exacta del atuendo, suministrada como soporte.\n\n    Pasa estas imágenes reales a la herramienta de edición de imagen en el mismo orden. No envíes solo la referencia del luchador o reemplaza el recorte de tipografía con una descripción escrita.\n\n    En una generación de edición de imagen, agrega el luchador y el borde blanco mientras conservas el arte de tipografía suministrado sin cambios como una sola imagen integrada. No generes una pose independiente y la pegues. No uses Python para componer.\n\n    Envía el siguiente mensaje de edición de imagen textualmente a la herramienta de imagen. No lo reescribas ni inventes un nuevo mensaje de generación.\n\n    Comienza el mensaje de edición de imagen\n\n      Edita la imagen base {{arte de palabra}} para crear la pegatina {{palabra}} como una sola imagen integrada.\n\n      Fondo primero: Verde plano uniforme puro #00FF00 solamente. Sin magenta, sin rosa, sin púrpura. Sin gradiente, textura, o sombras en el fondo. Este verde se eliminará para transparencia más tarde.\n\n      Bloqueo de tipografía: conserva el arte suministrado\n\n      La letra en9e:T2165,Crea cuatro pegatinas de luchador personalizadas utilizando las tres imágenes suministradas.\n\nEntradas\n\n  Entrada 1: Foto de identidad del usuario\n    Proporciona identidad, rostro, tono de piel, edad, cabello, vello facial, accesorios.\n\n  Entrada 2: Referencia exacta del atuendo\n    Proporciona camisa, pantalones cortos, guantes completos con logotipos, patrones, materiales, colores, colocación. Al crear la imagen de referencia, no le des zapatos al usuario. No deben dárseles zapatos.\n\n  Entrada 3: Hoja de tipografía\n    Imagen transparente con cuatro celdas: arriba a la izquierda GOAT, arriba a la derecha LFG, abajo a la izquierda AND NEW, abajo a la derecha UNDISPUTED. Este es arte real, no inspiración. Si se carga con fondo blanco, convierte el blanco a transparente y elimínalo, conservando la forma del texto. No rellenes áreas transparentes con color.\n\nRegla de fondo de segmentación (se aplica en todas partes)\n\n  Utiliza ÚNICAMENTE verde plano uniforme puro #00FF00 (RGB 0, 255, 0) para todos los fondos generados. Este verde es solo para segmentación y se eliminará para transparencia más tarde. No uses magenta #FF00FF, rosa, púrpura, ni ningún otro color de fondo. Sin gradiente, textura, sombras, ni viñeta en el fondo.\n\nRegla de fuente de arte de texto (se aplica a cada generación y edición)\n\n  La única fuente de letra permitida es la imagen de recorte de tipografía original preparada.\n  Cada generación de imagen o edición de imagen que muestre letra debe tener {{arte de palabra}} adjunto como entrada de imagen.\n  Un nombre de archivo, frase, descripción escrita, o pegatina generada previamente nunca es un sustituto.\n  No redibujes, reescribas, traces, sustituyas, aproximes, o reinterpretar la letra.\n  Mantén la letra delante del luchador, en su tamaño y posición originales.\n  Esto se aplica a la creación inicial, correcciones, reintentos, y todos los turnos de seguimiento.\n\nEtapa 1: Referencia canónica del luchador\n\n  Utiliza Entrada 1 + Entrada 2 para generar una referencia de cuerpo completo aislada de la persona que lleva el atuendo suministrado.\n\n  - Conserva la estructura facial reconocible, tono de piel, edad, cabello, vello facial, sombreros/gafas/cubiertas religiosas.\n  - Gafas, sombreros, cubiertas religiosas, dispositivos auditivos, y cualquier otro accesorio visible en la cara/cabeza en Entrada 1 son parte de la identidad de la persona. Consérvalos en la referencia canónica del luchador y en las cuatro pegatinas, con el mismo diseño, colores, y forma en que se llevan. No los elimines, reemplaces, o rediseñes para una pose o expresión.\n  - Anatomía fotográfica natural, sin músculos exagerados, sin cabeza/manos/pies agrandados.\n  - Transfiere la camisa, pantalones cortos, guantes exactos: cortes, longitudes, colores, materiales, patrones, logotipos, colocación. Se permiten pliegues naturales. No simplifiques ni inventes marcas.\n  - Pies descalzos a menos que haya calzado en Entrada 2.\n  - Fotorealista, con contraste ligeramente más fuerte, sombras direccionales malhumoradas. Grado editorial, no ilustración.\n  - Una persona, pose neutral de pie, todo el sombrero/cabello, ambas manos, ambas piernas, ambos pies visibles, márgenes cómodos.\n  - Genera en verde plano uniforme #00FF00, sin sombras ni gradiente. Sin borde. Sin magenta. Conserva como referencia canónica del luchador. No presentes al usuario.\n  - No le des zapatos al usuario.\n\n  Antes de continuar, confirma que la referencia conserva los accesorios de la cara/cabeza visibles en Entrada 1 y que el fondo es puro #00FF00.\n\nEtapa 2: Tipografía dividida\n\n  Lee las dimensiones de Entrada 3, recorta en los puntos medios horizontal y vertical en:\n    texto_cabra (arriba-izquierda), texto_lfg (arriba-derecha), texto_y_nuevo (abajo-izquierda), texto_indiscutible (abajo-derecha).\n\n  Conserva el lienzo completo, colocación, alfa. No recortes ajustados alrededor de la letra. Mantén las dimensiones originales de cada celda y conserva el tamaño y las coordenadas exactas del texto en relación con esa celda. Arriba sigue arriba, en medio sigue en medio, abajo sigue abajo; la colocación horizontal también permanece sin cambios. No muevas, redimensionar, recentrar, estirar, o refluir las palabras. No extiendas el lienzo de la celda. Utiliza estos recortes sin cambios como {{arte de palabra}} para la generación y cada edición posterior. No rellenes áreas transparentes con verde o magenta.\n\nEtapa 3: Cuatro ediciones de imagen en paralelo (borde en-generación)\n\n  Ejecuta una edición de imagen completa por celda en paralelo. Cada tarea obtiene: su recorte de tipografía preparado como base, la referencia canónica del luchador, y Entrada 2 como soporte. No pases solo descripciones de texto.\n\n  Utiliza el mismo mensaje de subagente a continuación para todas las cuatro tareas. Sustituye solo {{palabra}}, {{arte de palabra}}, {{pose}}, y {{archivo de salida}} utilizando las definiciones después de la plantilla. Reemplaza {{pose}} con la descripción completa de la pose, no un número de pose o resumen. Resuelve {{arte de palabra}} en la imagen real preparada y adjúntala; su nombre solo no es una entrada de imagen.\n\n  No parafrasees, acortes, embellezcas, o agregues diferentes instrucciones para diferentes agentes. Las únicas diferencias por agente son esas cuatro sustituciones y el recorte de tipografía correspondiente. Cada agente recibe la misma referencia canónica y la imagen del atuendo.\n\n  Incluye la misma descripción del borde y las instrucciones completas de eliminación de fondo en cada tarea del agente, incluyendo correcciones. Define una rutina de limpieza compartida determinista y haz que todos los agentes la reutilicen; no hagas que cada agente invente su algoritmo de segmentación de forma independiente. Mantén la generación de imágenes en paralelo. Si los agentes no pueden compartir la rutina, recopila sus renders intactos y ejecuta esa misma rutina de limpieza en los cuatro de forma centralizada.\n\n  Enrutamiento de seguimiento\n\n    La regla de reintentos y ediciones de seguimiento dentro de la plantilla del subagente es obligatoria para el padre y cada subagente en este turno y todos los turnos de seguimiento. Mantén cada pegatina asociada con su recorte de tipografía original preparado. Aplica la regla a cada corrección, incluyendo ediciones no relacionadas con la letra. Para trabajos de seguimiento, utiliza su plantilla de corrección en lugar de inventar un nuevo mensaje. Ejecuta correcciones independientes a pegatinas afectadas en paralelo donde sea compatible; deja las pegatinas no afectadas sin cambios.\n\nPlantilla de mensaje de subagente\n\n  Comienza el mensaje de subagente\n\n    Crea la pegatina {{palabra}} y devuelve {{archivo de salida}}.\n\n    Fondo de segmentación: Utiliza ÚNICAMENTE verde plano uniforme puro #00FF00. No uses magenta #FF00FF ni ningún otro color. Sin gradiente, textura, o sombras en el fondo.\n\n    Fuente de texto: {{arte de palabra}} es la única fuente de letra y debe adjuntarse. No reescribas las palabras.\n\n    Tienes tres imágenes adjuntas en este orden:\n      1. {{arte de palabra}}: el recorte de tipografía preparado. Esta es la imagen base para editar, no una referencia de estilo o inspiración.\n      2. Referencia canónica del luchador: la persona, proporciones, atuendo, y tratamiento fotográfico.\n      3. Entrada 2: la referencia exacta del atuendo, suministrada como soporte.\n\n    Pasa estas imágenes reales a la herramienta de edición de imagen en el mismo orden. No envíes solo la referencia del luchador o reemplaza el recorte de tipografía con una descripción escrita.\n\n    En una generación de edición de imagen, agrega el luchador y el borde blanco mientras conservas el arte de tipografía suministrado sin cambios como una sola imagen integrada. No generes una pose independiente y la pegues. No uses Python para componer.\n\n    Envía el siguiente mensaje de edición de imagen textualmente a la herramienta de imagen. No lo reescribas ni inventes un nuevo mensaje de generación.\n\n    Comienza el mensaje de edición de imagen\n\n      Edita la imagen base {{arte de palabra}} para crear la pegatina {{palabra}} como una sola imagen integrada.\n\n      Fondo primero: Verde plano uniforme puro #00FF00 solamente. Sin magenta, sin rosa, sin púrpura. Sin gradiente, textura, o sombras en el fondo. Este verde se eliminará para transparencia más tarde.\n\n      Bloqueo de tipografía: conserva el arte suministrado\n\n      La letra en90:[{\"id\":\"1761226631677884\",\"agentOption\":null,\"chipTitle\":\"yo en parapente\",\"clipTextRange\":{\"offset\":8,\"length\":15},\"displayedTitle\":\"Imagina yo en parapente\",\"capitalizedTitle\":\"Imagina Yo en parapente\",\"iconUri\":\"https://static.xx.fbcdn.net/rsrc.php/yQ/r/S7BiHLGF0qz.webp\",\"thumbnailUri\":\"https://scontent-iad3-2.xx.fbcdn.net/o1/v/t6/f2/m421/AQMe8i9dkoJUziHYFLhkGJ2I6Be886d95NCl4mbxDwG1QshQ2JRG_MkzZGUhhK67BWZm_ystldQFPfq-VzS1gnip.png?_nc_cat=111\u0026_nc_sid=5b3566\u0026_nc_ht=scontent-iad3-2.xx.fbcdn.net\u0026_nc_ohc=ajR4Ys2lq0IQ7kNvwFgA6NS\u0026stp=s325x325_tt6\u0026ccb=17-1\u0026_nc_gid=043zq5lIyt8yvj_2ONygfg\u0026_nc_zt=14\u0026_nc_ss=7b289\u0026oh=00_AQNWe3sf-ILN3dCcwRtz39-OuNLLOuv7fwuoNR3Kr0itUQ\u0026oe=6AF39125\",\"squareThumbnailUri\":\"https://scontent-iad3-2.xx.fbcdn.net/o1/v/t6/f2/m421/AQMe8i9dkoJUziHYFLhkGJ2I6Be886d95NCl4mbxDwG1QshQ2JRG_MkzZGUhhK67BWZm_ystldQFPfq-VzS1gnip.png?_nc_cat=111\u0026_nc_sid=5b3566\u0026_nc_ht=scontent-iad3-2.xx.fbcdn.net\u0026_nc_ohc=ajR4Ys2lq0IQ7kNvwFgA6NS\u0026stp=s325x325_tt6\u0026ccb=17-1\u0026_nc_gid=043zq5lIyt8yvj_2ONygfg\u0026_nc_zt=14\u0026_nc_ss=7b289\u0026oh=00_AQNWe3sf-ILN3dCcwRtz39-OuNLLOuv7fwuoNR3Kr0itUQ\u0026oe=6AF39125\",\"placeholderThumbnailUri\":null,\"capabilities\":[\"IMAGINE\"],\"isVideo\":false,\"category\":\"image\",\"attachmentType\":\"NONE\",\"multipleAttachments\":false,\"suggestedAttachmentCount\":null,\"mediaPickerSubtitle\":null,\"promptText\":\"Usa mi foto para colocarme en un parapente sobre un paisaje exótico impresionante. Haz que sea un selfie en primer plano con una cámara de acción a una altura media o alta, desde la mitad del pecho hacia arriba, con mi cara, gafas incluidas y hombros ocupando la mayor parte del encuadre. Muestra el dosel del paracaídas en la parte superior, distorsión de la lente panorámica, correas de arnés visibles en el pecho y yo con un casco y gafas de parapente, traje de vuelo completo y expresión de asombro mientras contemplo el paisaje.\",\"segments\":[{\"type\":\"static\",\"text\":\"Usa mi foto para colocarme en un parapente sobre un paisaje exótico impresionante. Haz que sea un selfie en primer plano con una cámara de acción a una altura media o alta, desde la mitad del pecho hacia arriba, con mi cara, gafas incluidas y hombros ocupando la mayor parte del encuadre. Muestra el dosel del paracaídas en la parte superior, distorsión de la lente panorámica, correas de arnés visibles en el pecho y yo con un casco y gafas de parapente, traje de vuelo completo y expresión de asombro mientras contemplo el paisaje.\"}],\"userInputSteps\":[]},{\"id\":\"960033576358748\",\"agentOption\":null,\"chipTitle\":\"Prueba de estilo\",\"clipTextRange\":{\"offset\":8,\"length\":16},\"displayedTitle\":\"Crea un Prueba de estilo para mí según las tendencias actuales\",\"capitalizedTitle\":\"Crea un Prueba de estilo para mí según las tendencias actuales\",\"iconUri\":\"https://static.xx.fbcdn.net/rsrc.php/yQ/r/S7BiHLGF0qz.webp\",\"thumbnailUri\":\"https://scontent-iad6-1.xx.fbcdn.net/o1/v/t6/f2/m421/AQPKGKFdHS1zuD2e8-Y2vdhKHHUjHiP7RUJo4JfUNA5RLJiAZbCDKu-_vXgIvJaI39FO8q5CKo4EhEbt52kuYWZK.png?_nc_cat=1\u0026_nc_sid=5b3566\u0026_nc_ht=scontent-iad6-1.xx.fbcdn.net\u0026_nc_ohc=bh98NU8UawMQ7kNvwF9mrYu\u0026stp=s325x325_tt6\u0026ccb=17-1\u0026_nc_gid=043zq5lIyt8yvj_2ONygfg\u0026_nc_zt=14\u0026_nc_ss=7b289\u0026oh=00_AQPvXwReyAZvulXB-Cj0CcdJ8Ga2Ld6cWQebrgQQjd-0Qg\u0026oe=6AF39F03\",\"squareThumbnailUri\":\"https://scontent-iad6-1.xx.fbcdn.net/o1/v/t6/f2/m421/AQPKGKFdHS1zuD2e8-Y2vdhKHHUjHiP7RUJo4JfUNA5RLJiAZbCDKu-_vXgIvJaI39FO8q5CKo4EhEbt52kuYWZK.png?_nc_cat=1\u0026_nc_sid=5b3566\u0026_nc_ht=scontent-iad6-1.xx.fbcdn.net\u0026_nc_ohc=bh98NU8UawMQ7kNvwF9mrYu\u0026stp=s325x325_tt6\u0026ccb=17-1\u0026_nc_gid=043zq5lIyt8yvj_2ONygfg\u0026_nc_zt=14\u0026_nc_ss=7b289\u0026oh=00_AQPvXwReyAZvulXB-Cj0CcdJ8Ga2Ld6cWQebrgQQjd-0Qg\u0026oe=6AF39F03\",\"placeholderThumbnailUri\":null,\"capabilities\":[\"IMAGINE\"],\"isVideo\":false,\"category\":\"image\",\"attachmentType\":\"NONE\",\"multipleAttachments\":false,\"suggestedAttachmentCount\":null,\"mediaPickerSubtitle\":null,\"promptText\":\"$9b\",\"segments\":[{\"type\":\"static\",\"text\":\"$9c\"}],\"userInputSteps\":[]},{\"id\":\"2162391794577305\",\"agentOption\":\"MODE_FAST\",\"chipTitle\":\"Skate de los 90\",\"clipTextRange\":{\"offset\":7,\"length\":15},\"displayedTitle\":\"GIF me Skate de los 90\",\"capitalizedTitle\":\"GIF me Skate de los 90\",\"iconUri\":\"https://static.xx.fbcdn.net/rsrc.php/yQ/r/S7BiHLGF0qz.webp\",\"thumbnailUri\":\"https://scontent-iad3-2.xx.fbcdn.net/o1/v/t6/f2/m421/AQNxQM2iX937VIImugyRgE-xmQbyW-3p6JrJl0wttHj0emhsNrPSh-k4kncz46g-nLy6-m3VWaEWu-ETYFm9CkU7.gif?_nc_cat=105\u0026_nc_sid=5b3566\u0026_nc_ht=scontent-iad3-2.xx.fbcdn.net\u0026_nc_ohc=c-TNn26frq8Q7kNvwESl2Nv\u0026stp=s325x325_tt6\u0026ccb=17-1\u0026_nc_gid=043zq5lIyt8yvj_2ONygfg\u0026_nc_ss=7b289\u0026_nc_zt=14\u0026oh=00_AQNt2074EPoZxg3Iyzoiq32lpX-YlKH21Nuw4QfOfaj9CQ\u0026oe=6AF387DF\",\"squareThumbnailUri\":\"https://scontent-iad3-2.xx.fbcdn.net/o1/v/t6/f2/m421/AQNxQM2iX937VIImugyRgE-xmQbyW-3p6JrJl0wttHj0emhsNrPSh-k4kncz46g-nLy6-m3VWaEWu-ETYFm9CkU7.gif?_nc_cat=105\u0026_nc_sid=5b3566\u0026_nc_ht=scontent-iad3-2.xx.fbcdn.net\u0026_nc_ohc=c-TNn26frq8Q7kNvwESl2Nv\u0026stp=s325x325_tt6\u0026ccb=17-1\u0026_nc_gid=043zq5lIyt8yvj_2ONygfg\u0026_nc_ss=7b289\u0026_nc_zt=14\u0026oh=00_AQNt2074EPoZxg3Iyzoiq32lpX-YlKH21Nuw4QfOfaj9CQ\u0026oe=6AF387DF\",\"placeholderThumbnailUri\":\"https://scontent-iad3-2.xx.fbcdn.net/o1/v/t6/f2/m421/AQO7VTaEx8nC26-PhGM_zcP4P0CvvLMjQEOVFD3PuAnLYPldGitLHHdIdSUWxFwK2ypRG_XNZ-CP0T9EX68wkAlP.jpg?_nc_cat=105\u0026_nc_sid=5b3566\u0026_nc_ht=scontent-iad3-2.xx.fbcdn.net\u0026_nc_ohc=PlGX6uqiUrYQ7kNvwHm8LRq\u0026stp=s325x325_tt6\u0026ccb=17-1\u0026_nc_gid=043zq5lIyt8yvj_2O